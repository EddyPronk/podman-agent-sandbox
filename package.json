{
  "name": "podman-agent-sandbox",
  "version": "0.8.0",
  "description": "A rootless Podman sandbox for running coding agents",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "sandbox": "bin/sandbox.js"
  },
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build && rm -rf test-build && tsc -p test",
    "test": "node --test test/*.test.js test-build/*.test.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@devcontainers/cli": "0.89.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.6.3"
  }
}
