FROM docker.io/library/debian:trixie-slim

# Debian with rootless podman and Node.js: a sandbox that runs its own containers and the sandbox
# command. Debian's podman only recommends uidmap (newuidmap/newgidmap), passt (pasta, the network
# for rootless containers) and aardvark-dns (names on podman networks), so they're listed; nftables
# is netavark's firewall driver for NAT networks.
RUN apt-get update && apt-get install -y --no-install-recommends \
        aardvark-dns \
        ca-certificates \
        curl \
        nftables \
        nodejs \
        npm \
        passt \
        podman \
        uidmap \
    && rm -rf /var/lib/apt/lists/*

# Subordinate IDs for the user, so the inner podman can map a range: every ID this sandbox has
# besides the user's own (keep-id maps 0..65536 inside). The user only exists at runtime, so the
# owner is the UID, which subuid(5) allows; it comes from the host's SANDBOX_UID.
ARG SANDBOX_UID=1000
RUN u=$SANDBOX_UID \
    && printf '%s:1:%s\n%s:%s:%s\n' "$u" "$((u - 1))" "$u" "$((u + 1))" "$((65536 - u))" > /etc/subuid \
    && cp /etc/subuid /etc/subgid

# newuidmap/newgidmap with file capabilities instead of the setuid bit: with setuid root the kernel
# refuses the inner podman's map ("write to uid_map failed: Operation not permitted"); with a file
# capability they keep running as the user, the owner of the new namespace.
RUN apt-get update && apt-get install -y --no-install-recommends libcap2-bin \
    && chmod 0755 /usr/bin/newuidmap /usr/bin/newgidmap \
    && setcap cap_setuid=ep /usr/bin/newuidmap \
    && setcap cap_setgid=ep /usr/bin/newgidmap \
    && rm -rf /var/lib/apt/lists/*
