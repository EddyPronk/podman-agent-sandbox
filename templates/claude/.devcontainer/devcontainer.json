{
  "name": "${localWorkspaceFolderBasename}",
  "build": {
    "dockerfile": "Containerfile",
    "args": {
      "BASE_IMAGE": "${templateOption:image}",
      "SANDBOX_UID": "${localEnv:SANDBOX_UID:1000}",
      "SANDBOX_USER": "${localEnv:USER}"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24",
      "nodeGypDependencies": false,
      "pnpmVersion": "none"
    }
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "containerUser": "${localEnv:SANDBOX_UID:1000}:${localEnv:SANDBOX_GID:1000}",
  "remoteUser": "${localEnv:USER}",
  "updateRemoteUserUID": false,
  "remoteEnv": {
    "TERM": "${localEnv:TERM:xterm-256color}",
    "USER": "${localEnv:USER}",
    "LOGNAME": "${localEnv:USER}"
  },
  "containerEnv": {
    "NVM_SYMLINK_CURRENT": "false"
  },
  "postCreateCommand": "cp -r --update=none /etc/skel/. \"$HOME\"/",
  "mounts": [
    "type=volume,source=${localWorkspaceFolderBasename}-home,target=/home/${localEnv:USER},U=true",
    "type=bind,source=${localWorkspaceFolder}/.devcontainer,target=/workspace/.devcontainer,readonly"
  ],
  "runArgs": [
    "--name",
    "${localWorkspaceFolderBasename}",
    "--hostname",
    "${localWorkspaceFolderBasename}",
    "--label=podman-agent-sandbox=${localEnv:SANDBOX_VERSION}",
    "--userns=keep-id",
    "--tmpfs=/tmp:rw,exec,nosuid,nodev,mode=1777",
    "--cap-drop=all",
    "--security-opt=no-new-privileges"
  ],
  "customizations": {
    "podman-agent-sandbox": {
      "version": 1,
      "agent": "claude-code",
      "policies": []
    }
  }
}
