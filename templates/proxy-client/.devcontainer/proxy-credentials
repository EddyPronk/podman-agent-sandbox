#!/bin/sh
# proxy-credentials fetch [--force]: gets ~/.claude/.credentials.json from the egress proxy's
# credential vault, and marks Claude Code's onboarding done in ~/.claude.json, so that it starts
# without a sign-in. The file holds placeholders only; the proxy swaps them for the real tokens on
# the way to Anthropic. Needs a proxy made with credentialVault=1 (agent-mitm-proxy 1.4.0 or later)
# that holds a sign-in, and, with clientAuth=1, a sign-in this sandbox is granted.
set -eu
[ "${1:-}" = fetch ] || { echo "usage: proxy-credentials fetch [--force]" >&2; exit 2; }
file=$HOME/.claude/.credentials.json
if [ -e "$file" ] && [ "${2:-}" != --force ]; then
    echo "$file exists; --force replaces it" >&2
    exit 1
fi
mkdir -p "$HOME/.claude"
umask 077
tmp=$(mktemp "$HOME/.claude/.credentials.XXXXXX")
trap 'rm -f "$tmp"' EXIT
# The proxy answers this made-up host itself; nothing goes to the Internet.
status=$(curl -sS -o "$tmp" -w '%{http_code}' --max-time 20 http://agent-mitm-proxy.internal/v1/credentials/claude) || status=000
if [ "$status" != 200 ]; then
    case $status in
        404) echo "proxy-credentials: the proxy's vault holds no sign-in for this sandbox yet: run /login in Claude Code once" >&2 ;;
        407) echo "proxy-credentials: the proxy refused this sandbox's name and token (407)" >&2 ;;
        *)   echo "proxy-credentials: the proxy answered $status (is it running, with credentialVault=1 and agent-mitm-proxy 1.4.0?)" >&2 ;;
    esac
    exit 1
fi
mv "$tmp" "$file"
trap - EXIT
# Claude Code asks to sign in again unless onboarding is marked done.
node -e '
const fs = require("fs"), f = process.env.HOME + "/.claude.json";
let o = {}; try { o = JSON.parse(fs.readFileSync(f, "utf8")); } catch {}
o.hasCompletedOnboarding = true;
fs.writeFileSync(f, JSON.stringify(o), { mode: 0o600 });
'
echo "proxy-credentials: fetched $file (placeholders)"
