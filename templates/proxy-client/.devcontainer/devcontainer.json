{
  "name": "${localWorkspaceFolderBasename}",
  "build": {
    "dockerfile": "Containerfile",
    "args": {
      "BASE_IMAGE": "${templateOption:image}",
      "SANDBOX_UID": "${localEnv:SANDBOX_UID:1000}",
      "SANDBOX_USER": "${localEnv:USER}"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "nodeGypDependencies": false,
      "pnpmVersion": "none"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/node",
    "ghcr.io/anthropics/devcontainer-features/claude-code"
  ],
  "initializeCommand": "podman network exists agent-proxy-net || podman network create --internal agent-proxy-net; sh .devcontainer/proxy-env.sh \"${localWorkspaceFolderBasename}\" \"${templateOption:clientAuth}\"",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "containerUser": "${localEnv:SANDBOX_UID:1000}:${localEnv:SANDBOX_GID:1000}",
  "remoteUser": "${localEnv:USER}",
  "updateRemoteUserUID": false,
  "remoteEnv": {
    "TERM": "${localEnv:TERM:xterm-256color}",
    "USER": "${localEnv:USER}",
    "LOGNAME": "${localEnv:USER}"
  },
  "containerEnv": {
    "NO_PROXY": "localhost,127.0.0.1,proxy",
    "no_proxy": "localhost,127.0.0.1,proxy",
    "CURL_CA_BUNDLE": "/proxy-ca/ca-cert.pem",
    "NODE_EXTRA_CA_CERTS": "/proxy-ca/ca-cert.pem",
    "DISABLE_AUTOUPDATER": "1",
    "NVM_SYMLINK_CURRENT": "false"
  },
  "postCreateCommand": "cp -r --update=none /etc/skel/. \"$HOME\"/; proxy-credentials fetch || true; proxy-gatekeeper connect || true; [ \"${templateOption:trustWorkspace}\" != 1 ] || trust-workspace \"${containerWorkspaceFolder}\"",
  "mounts": [
    "type=volume,source=${localWorkspaceFolderBasename}-home,target=/home/${localEnv:USER},U=true",
    "type=volume,source=agent-proxy-ca,target=/proxy-ca,readonly",
    "type=bind,source=${localWorkspaceFolder}/.devcontainer,target=/workspace/.devcontainer,readonly"
  ],
  "runArgs": [
    "--name",
    "${localWorkspaceFolderBasename}",
    "--hostname",
    "${localWorkspaceFolderBasename}",
    "--label=podman-agent-sandbox=${localEnv:SANDBOX_VERSION}",
    "--env-file=${localWorkspaceFolder}/proxy.env",
    "--userns=keep-id",
    "--cap-drop=all",
    "--security-opt=no-new-privileges",
    "--network=agent-proxy-net"
  ],
  "customizations": {
    "podman-agent-sandbox": {
      "version": 1,
      "policies": []
    }
  }
}
