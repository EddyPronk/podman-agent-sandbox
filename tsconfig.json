{
  "//": "Builds src/ into dist/ (npm run build) and type-checks the files marked // @ts-check (npm run typecheck)",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "allowJs": true,
    "strict": true,
    "noImplicitAny": false,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src"]
}
